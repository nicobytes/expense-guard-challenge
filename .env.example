# Expense Guard routes model calls through the Vercel AI Gateway (bare gateway model
# ids like "anthropic/claude-...") — provide a gateway key so `eve dev` / `eve eval`
# can reach a model:
AI_GATEWAY_API_KEY=

# Host for just review / Vitest HTTP tests (defaults to http://127.0.0.1:2000):
EVE_HOST=http://127.0.0.1:2000
